610        /*                                                                                                */
611        /*   ProcessYearlyQuarter - one call per quarterly file: log, import, clean up                    */
612        /*                                                                                                */
613        /**************************************************************************************************/
614        
615        %MACRO ProcessYearlyQuarter(YearQtr=);
616            %LOCAL SrcFile;
617        
618            %LET SYSCC   = 0;
619            %LET SrcFile = &YearQtr..csv.gz;
620        
621            %CreateRunLog;
622        
623            %ImportQuarterlyFile(File=&SrcFile);
624        
625            %IF &SYSCC <= 4 %THEN %DO;
626                %DeleteSourceFile(File=&SrcFile);
627            %END;
628            %ELSE %DO;
629                /********************************************************************/
630                %PUT ERROR: &SrcFile was not processed cleanly - source file kept in RAW;
631                /********************************************************************/
632            %END;
633        %MEND ProcessYearlyQuarter;
