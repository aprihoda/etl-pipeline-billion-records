641        %MACRO ExportRunLog(OutFile=&root/RunLog.md);
642            DATA _NULL_;
643                FILE "&OutFile";
644                SET FNMAE.RunLog;
645                LENGTH Line $200;
646        
647                IF _N_ = 1 THEN DO;
648                    PUT "| Quarter | Source file | Monthly records | Loans | Defaults | Process time | Cumulative records |";
649                    PUT "|:--|:--|--:|--:|--:|--:|--:|";
650                END;
651        
652                Line = CATX(" | ", Quarter, SourceFile,
653                            PUT(RawRows, COMMA16.), PUT(LoanRows, COMMA12.),
654                            PUT(Defaults, COMMA10.), PUT(ProcessTime, TIME12.2),
655                            PUT(CumRawRows, COMMA16.));
656                PUT "| " Line +(-1) " |";
657            RUN;
658        
659            /**************************************/
660            %PUT NOTE: Run log exported to &OutFile;
661            /**************************************/
662        %MEND ExportRunLog;
