 70         /**************************************************************************************************/
 71         /*                                                                                                */
 72         /*   Project : ETL Macro for Processing a Billion-Plus Records                                    */
 73         /*   Program : EtlPipeline_Report.sas                                                             */
 74         /*   Author  : Anne M. Prihoda                                                                    */
 75         /*                                                                                                */
 76         /*   Purpose : Produce the pipeline report PDF: overview, complete run log, and                   */
 77         /*             throughput summary, generated from FNMAE.RunLog.                                   */
 78         /*                                                                                                */
 79         /**************************************************************************************************/
 80         
 81         %LET root = /home/bvsierrap0;
 82         
 83         LIBNAME FNMAE "&root/FNMAE" COMPRESS=YES;
 NOTE: Libref FNMAE was successfully assigned as follows: 
       Engine:        V9 
       Physical Name: /home/bvsierrap0/FNMAE
 84         
 85         OPTIONS NODATE NONUMBER ORIENTATION=PORTRAIT
 86                 TOPMARGIN=1IN BOTTOMMARGIN=1IN LEFTMARGIN=1IN RIGHTMARGIN=1IN;
 87         ODS _ALL_ CLOSE;
 88         ODS GRAPHICS ON / WIDTH=6.4IN HEIGHT=2.6IN OUTPUTFMT=PNG;
 89         ODS ESCAPECHAR='^';
 90         
 91         ODS PDF FILE="&root/EtlPipeline_Report.pdf" STYLE=PEARL STARTPAGE=NO;
 NOTE: Writing ODS PDF output to DISK destination "/home/bvsierrap0/EtlPipeline_Report.pdf", printer "PDF".
 92         
 93         
 94         ODS PDF TEXT="^{newline 2}";
 95         ODS PDF TEXT="^{style [FONTSIZE=26PT FONTWEIGHT=BOLD COLOR=CX1F4E79 JUST=C] ETL Pipeline}";
 96         ODS PDF TEXT="^{style [FONTSIZE=17PT FONTWEIGHT=BOLD COLOR=CX1F4E79 JUST=C] ~1.2 Billion Records Processed in a 5 GB
 96       ! Environment}";
 97         ODS PDF TEXT="^{newline 2}";
 98         ODS PDF TEXT="^{style [FONTSIZE=13PT JUST=C] Fannie Mae Single-Family Loan Performance Data}";
 99         ODS PDF TEXT="^{style [FONTSIZE=13PT JUST=C] Anne M. Prihoda}";
 100        ODS PDF TEXT="^{newline 3}";
 101        
 102        ODS PDF TEXT="^{style [FONTSIZE=14PT FONTWEIGHT=BOLD COLOR=CX1F4E79] What the pipeline does}";
 103        ODS PDF TEXT="^{newline}";
 104        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Processes 48 Fannie Mae quarterly loan performance files - over one billion
 104      ! pipe-delimited monthly records}";
 105        ODS PDF TEXT="^{newline}";
 106        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Operates inside a 5 GB SAS OnDemand environment with a 1 GB per-file upload
 106      ! limit}";
 107        ODS PDF TEXT="^{newline}";
 108        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Quarters exceeding the 1 GB upload limit are pre-split on loan boundaries by
 108      ! a PowerShell utility: Cutting only between loans keeps loan history intact}";
 109        ODS PDF TEXT="^{newline}";
 110        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Source files are read directly from gzip through the FILENAME ZIP engine:
 110      ! Enables 35 GB of raw text to be processed within the 5 GB storage limit}";
 111        ODS PDF TEXT="^{newline}";
 112        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Retains only the fields the scorecard requires, applies informats to convert
 112      ! MMYYYY dates and coded text, and derives the modelling fields: minimum credit score, origination quarter, and the default
 112      !  flag}";
 113        ODS PDF TEXT="^{newline}";
 114        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Collapses each loan history of monthly records into a single analytical row
 114      ! carrying its origination characteristics and final outcome, then appends it to the master table}";
 115        ODS PDF TEXT="^{newline}";
 116        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Runs idempotently - reprocessing a file replaces its prior load, never
 116      ! duplicates it}";
 117        ODS PDF TEXT="^{newline}";
 118        ODS PDF TEXT="^{style [FONTSIZE=13PT]    -  Records the counts for every file in the processing record, which reconciles
 118      ! to Fannie Mae published statistical summaries}";
 119        ODS PDF STARTPAGE=NOW;
