353                /*  Dates arrive as MMYYYY digits (122025 = December 2025). Convert to                    */
354                /*  SAS date values so that MMYYS7. displays correctly and INTCK / INTNX                  */
355                /*  and numeric sorting all operate on true dates.                                        */
356                ARRAY _dt {*}  MonthlyReportingPeriod OriginationDate FirstPaymentDate
357                               MaturityDate InterestOnlyFirstPrincipalAndInt
358                               ZeroBalanceEffectiveDate RepurchaseDate
359                               LastPaidInstallmentDate ForeclosureDate DispositionDate
360                               OriginalListStartDate CurrentListStartDate
361                               ZeroBalanceCodeChangeDate LoanHoldbackEffectiveDate
362                               NextInterestRateAdjustmentDate NextPaymentChangeDate;
363        
364                DO _i = 1 to DIM(_dt);
365                    IF _dt{_i} > 9999 THEN
366                        _dt{_i} = mdy(int(_dt{_i}/10000), 1, mod(_dt{_i}, 10000));
367                    ELSE _dt{_i} = .;
368                END;
