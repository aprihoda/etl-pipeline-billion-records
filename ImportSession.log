69         /**************************************************************************************************/
70         /*                                                                                                */
71         /*   Project : Credit Risk Scorecard - Fannie Mae Single-Family Loan Performance Data             */
72         /*   Program : CreditRiskScorecard_BuildLoanMaster.sas                                            */
73         /*   Author  : Anne M. Prihoda                                                                    */
74         /*                                                                                                */
75         /*   Purpose : Build the loan-level base for the scorecard. Process one Fannie Mae Single-        */
76         /*             Family Loan Performance file end to end:                                           */
77         /*             read the gzipped source, collapse to one row per loan, replace any prior load      */
78         /*             of the same file, append to the master analytical table, record the run in         */
79         /*             acquisition-quarter order, and release working storage.                            */
80         /*                                                                                                */
81         /*   Data    : Pipe-delimited, 113 fields, no header row. Field 1 (Reference Pool ID) is not      */
82         /*             populated, so every record begins with a delimiter. Source files are gzipped       */
83         /*             locally and read directly through the FILENAME zip engine - the uncompressed       */
84         /*             data never occupies server storage.                                                */
85         /*                                                                                                */
86         /*   Output  : FNMAE.LoanMaster - one row per loan, accumulates across all files                  */
87         /*             FNMAE.RunLog     - one row per file processed, with running record count           */
88         /*                                                                                                */
89         /*   Default : Fannie Mae definition - Zero Balance Code in (02, 03, 09, 15) AND a non-null       */
90         /*             Disposition Date. Code 06 is a repurchase, not a default.                          */
91         /*                                                                                                */
92         /**************************************************************************************************/
93         
94         %LET root = /home/bvsierrap0;
95         
96         LIBNAME RAW   "&root/RAW"   COMPRESS=YES;
NOTE: Libref RAW was successfully assigned as follows: 
      Engine:        V9 
      Physical Name: /home/bvsierrap0/RAW
97         LIBNAME FNMAE "&root/FNMAE" COMPRESS=YES;
NOTE: Libref FNMAE was successfully assigned as follows: 
      Engine:        V9 
      Physical Name: /home/bvsierrap0/FNMAE
98         
99         
100        /**************************************************************************************************/
101        /*                                                                                                */
102        /*   RunLog - created once, appended to thereafter                                                */
103        /*                                                                                                */
104        /**************************************************************************************************/
105        
106        %MACRO CreateRunLog;
107            %IF NOT %SYSFUNC(EXIST(FNMAE.RunLog)) %THEN %DO;
108                DATA FNMAE.RunLog;
109                    ATTRIB
110                        RunSeq       LENGTH=8    LABEL="Sequence"              FORMAT=COMMA8.
111                        Quarter      LENGTH=$6   LABEL="Acquisition quarter"
112                        SourceFile   LENGTH=$40  LABEL="Source file"
113                        RawRows      LENGTH=8    LABEL="Monthly records read"  FORMAT=COMMA16.
114                        LoanRows     LENGTH=8    LABEL="Loans after collapse"  FORMAT=COMMA16.
115                        Defaults     LENGTH=8    LABEL="Defaults identified"   FORMAT=COMMA16.
116                        ProcessTime  LENGTH=8    LABEL="Processing time"       FORMAT=TIME12.2
117                        CumRawRows   LENGTH=8    LABEL="Cumulative records"    FORMAT=COMMA16.
118                    ;
2                                                          The SAS System                       Tuesday, August  4, 2026 04:24:32 PM

119                    STOP;
120                RUN;
121                %PUT NOTE: FNMAE.RunLog created.;
122            %END;
123        %MEND CreateRunLog;
