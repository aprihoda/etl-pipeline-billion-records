126        /**************************************************************************************************/
127        /*                                                                                                */
128        /*   ImportQuarterlyFile - the entire per-file routine                                            */
129        /*                                                                                                */
130        /**************************************************************************************************/
131        
132        %MACRO ImportQuarterlyFile(File=, SrcDir=&root/RAW);
133        
134            %LOCAL YearQtr AcqQtr Dsid Rc T0 T1 Elapsed RawRows LoanRows Defaults Cum PriorRuns HasSrc HasPt HasFico;
135        
136            %LET YearQtr = %SCAN(&File, 1, .);
137            %LET AcqQtr  = %SUBSTR(&YearQtr, 1, 6);
138            %LET T0  = %SYSFUNC(DATETIME());
