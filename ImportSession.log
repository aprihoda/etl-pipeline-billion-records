588        /*                                                                                                */
589        /*   DeleteSourceFile - remove a processed source file from RAW                                   */
590        /*                                                                                                */
591        /**************************************************************************************************/
592        
593        %MACRO DeleteSourceFile(File=, SrcDir=&root/RAW);
594            %LOCAL Rc Fref;
595            %LET Fref = _dsrc;
596        
597            %IF %SYSFUNC(FILEEXIST(&SrcDir./&File)) %THEN %DO;
598                %LET Rc = %SYSFUNC(FILENAME(Fref, &SrcDir./&File));
599                %LET Rc = %SYSFUNC(FDELETE(&Fref));
600                %LET Rc = %SYSFUNC(FILENAME(Fref));
601        
602                /********************************/
603                %PUT NOTE: &File removed from RAW;
604                /********************************/
605            %END;
606        %MEND DeleteSourceFile;
607        
